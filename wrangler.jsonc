{
  // Cloudflare 배포 설정.
  // 정적 자산(out/)을 서빙하되, intervals.icu OAuth 토큰 교환만 Worker가 처리한다.
  // (client_secret 을 브라우저에 노출하지 않기 위한 유일한 서버 코드 — worker/index.ts)
  // /api/icu/* 외 모든 요청은 Worker가 ASSETS 로 그대로 흘려보냄 → 기존 정적 사이트 그대로 동작.
  "name": "running-crew",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "vars": {
    // client_id 는 공개돼도 되는 값(authorize URL 에 그대로 들어감). 배포 시 실제 값으로 채울 것.
    // client_secret 은 여기 두지 말 것 → `npx wrangler secret put ICU_CLIENT_SECRET`
    "ICU_CLIENT_ID": "475",
    // 웹훅 Worker 가 Supabase REST 를 호출할 베이스 URL(공개 가능, NEXT_PUBLIC_SUPABASE_URL 과 동일).
    // 예: "https://xxxx.supabase.co". service role 키·webhook secret 은 secret 으로 따로 주입.
    "SUPABASE_URL": ""
  }
}
